{# ERP Computed Fields 模板 — 从 Money 类型字段生成计算函数 stub #}
{# 预期 YAML 变量:                                                          #}
{#   entity.name               — 实体名 (e.g. SaleOrderLine)                #}
{#   entity.computed_fields[]   — 计算字段列表                               #}
{#     .name          — 字段名 (e.g. price_subtotal)                        #}
{#     .formula       — 计算公式描述 (e.g. "qty * price_unit * (1 - discount)")#}
{#     .depends_on[]  — 依赖字段列表                                         #}
{#   entity.parent             — 父实体名 (header-line 场景)                  #}
use rust_decimal::Decimal;

use erp_shared::computed::{compute_line, compute_order_totals, LineComputed, OrderComputed};

/// {{ entity.name }} 计算字段模块
///
/// 说明：由 Tera 模板自动生成，提供领域特定的计算辅助函数。
/// 底层委托给 `erp_shared::computed` 纯函数。

{% if entity.computed_fields is defined and entity.computed_fields | length > 0 %}
// ============ Line-level Computed ============

/// 计算单行 {{ entity.name }} 的金额
///
/// 依赖字段:
{% for cf in entity.computed_fields %}
///   - {{ cf.name }}: {{ cf.formula | default(value="见 erp_shared::compute_line") }}
{% endfor %}
pub fn compute_{{ entity.name | snake_case }}_line(
    quantity: f64,
    price_unit: Decimal,
    discount: f64,
    tax_rates: &[Decimal],
) -> LineComputed {
    compute_line(quantity, price_unit, discount, tax_rates)
}

{% endif %}
{% if entity.parent is defined %}
// ============ Order-level Computed ============

/// 汇总 {{ entity.parent }} 的所有 {{ entity.name }} 行合计
pub fn compute_{{ entity.parent | snake_case }}_totals(lines: &[LineComputed]) -> OrderComputed {
    compute_order_totals(lines)
}
{% endif %}

// <<< block:custom_computed
// 在这里添加自定义计算函数（会在重新生成时保留）
// >>> end:custom_computed

#[cfg(test)]
mod tests {
    use super::*;
    use rust_decimal_macros::dec;

{% if entity.computed_fields is defined and entity.computed_fields | length > 0 %}
    #[test]
    fn test_compute_{{ entity.name | snake_case }}_line_basic() {
        let result = compute_{{ entity.name | snake_case }}_line(
            10.0,
            dec!(100),
            0.1,
            &[dec!(0.13)],
        );
        // qty=10, unit=100, discount=10% → subtotal = 900
        assert_eq!(result.price_subtotal, dec!(900));
    }
{% endif %}

{% if entity.parent is defined %}
    #[test]
    fn test_compute_{{ entity.parent | snake_case }}_totals_empty() {
        let result = compute_{{ entity.parent | snake_case }}_totals(&[]);
        assert_eq!(result.amount_total, Decimal::ZERO);
    }
{% endif %}
}
