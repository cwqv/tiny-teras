{# ERP Flutter List Page 模板 — 生成带 filter chip 和状态筛选的列表页 #}
{# 预期 YAML 变量:                                                               #}
{#   entity.name             — 实体名 (e.g. Partner)                             #}
{#   entity.fields[]         — 字段列表                                           #}
{#   entity.enums[]          — 枚举列表 (用于 FilterChip)                         #}
{#   entity.features         — 特性开关                                           #}
{#   entity.indexed_fields[] — 可搜索字段名列表                                    #}
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../providers/{{ entity.name | snake_case }}_providers.dart';
import '../../domain/entities/{{ entity.name | snake_case }}.dart';
import '{{ entity.name | snake_case }}_form_page.dart';

/// {{ entity.name }} 列表页面（ERP 风格 — 含筛选芯片 + 搜索）
class {{ entity.name }}ListPage extends ConsumerStatefulWidget {
{% if entity.features.tenant_aware | default(value=false) %}
  final String tenantId;

  const {{ entity.name }}ListPage({
    super.key,
    required this.tenantId,
  });
{% else %}
  const {{ entity.name }}ListPage({super.key});
{% endif %}

  @override
  ConsumerState<{{ entity.name }}ListPage> createState() => _{{ entity.name }}ListPageState();
}

class _{{ entity.name }}ListPageState extends ConsumerState<{{ entity.name }}ListPage> {
  final _searchController = TextEditingController();
  String? _searchQuery;
{% for enum in entity.enums | default(value=[]) %}
{% if enum.is_state_machine | default(value=false) %}
  {{ enum.rust_enum_name }}? _selected{{ enum.rust_enum_name }};
{% endif %}
{% endfor %}

  @override
  void dispose() {
    _searchController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final listAsync = ref.watch({{ entity.name | snake_case }}ListProvider(
{% if entity.features.tenant_aware | default(value=false) %}
      tenantId: widget.tenantId,
{% endif %}
      searchQuery: _searchQuery,
    ));

    return Scaffold(
      appBar: AppBar(
        title: const Text('{{ entity.name }}'),
        actions: [
          IconButton(
            icon: const Icon(Icons.add),
            onPressed: () => _navigateToForm(context),
          ),
        ],
      ),
      body: Column(
        children: [
          // ── 搜索栏 ──
          Padding(
            padding: const EdgeInsets.fromLTRB(16, 12, 16, 4),
            child: TextField(
              controller: _searchController,
              decoration: InputDecoration(
                hintText: '搜索{{ entity.name }}...',
                prefixIcon: const Icon(Icons.search),
                suffixIcon: _searchQuery != null
                    ? IconButton(
                        icon: const Icon(Icons.clear),
                        onPressed: () {
                          _searchController.clear();
                          setState(() => _searchQuery = null);
                        },
                      )
                    : null,
                border: const OutlineInputBorder(),
                isDense: true,
              ),
              onChanged: (value) {
                setState(() {
                  _searchQuery = value.isEmpty ? null : value;
                });
              },
            ),
          ),

{% if entity.enums is defined and entity.enums | length > 0 %}
          // ── 筛选芯片 ──
          SingleChildScrollView(
            scrollDirection: Axis.horizontal,
            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
            child: Row(
              children: [
{% for enum in entity.enums | default(value=[]) %}
{% if enum.is_state_machine | default(value=false) %}
                FilterChip(
                  label: const Text('全部状态'),
                  selected: _selected{{ enum.rust_enum_name }} == null,
                  onSelected: (_) => setState(() => _selected{{ enum.rust_enum_name }} = null),
                ),
                const SizedBox(width: 8),
{% for variant in enum.variants %}
                FilterChip(
                  label: const Text('{{ variant.display | default(value=variant.name) }}'),
                  selected: _selected{{ enum.rust_enum_name }} == {{ enum.rust_enum_name }}.{{ variant.pascal_case | default(value=variant.name) }},
                  onSelected: (_) => setState(
                    () => _selected{{ enum.rust_enum_name }} = {{ enum.rust_enum_name }}.{{ variant.pascal_case | default(value=variant.name) }},
                  ),
                ),
                const SizedBox(width: 8),
{% endfor %}
{% endif %}
{% endfor %}
              ],
            ),
          ),
{% endif %}

          // ── 列表 ──
          Expanded(
            child: listAsync.when(
              data: (entities) {
                if (entities.isEmpty) {
                  return const Center(child: Text('暂无数据'));
                }
                return ListView.builder(
                  itemCount: entities.length,
                  itemBuilder: (context, index) {
                    final item = entities[index];
                    return _buildListTile(context, item);
                  },
                );
              },
              loading: () => const Center(child: CircularProgressIndicator()),
              error: (error, _) => Center(child: Text('加载失败: $error')),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildListTile(BuildContext context, {{ entity.name }} item) {
    return ListTile(
      title: Text(item.name{% if entity.fields | selectattr("name", "eq", "name") | first is undefined %}.toString(){% endif %}),
      subtitle: Text('ID: ${item.id}'),
{% for enum in entity.enums | default(value=[]) %}
{% if enum.is_state_machine | default(value=false) %}
      trailing: Chip(label: Text(item.state.name)),
{% endif %}
{% endfor %}
      onTap: () => _navigateToForm(context, entity: item),
    );
  }

  void _navigateToForm(BuildContext context, {{{ entity.name }}? entity}) {
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => {{ entity.name }}FormPage(
{% if entity.features.tenant_aware | default(value=false) %}
          tenantId: widget.tenantId,
{% endif %}
          entity: entity,
        ),
      ),
    );
  }
}
