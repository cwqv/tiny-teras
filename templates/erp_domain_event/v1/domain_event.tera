{# ERP Domain Event 模板 — 从聚合根状态转换生成事件结构体 #}
{# 预期 YAML 变量:                                                          #}
{#   entity.name          — 聚合根名 (e.g. SaleOrder)                       #}
{#   entity.events[]      — 领域事件列表                                     #}
{#     .name              — 事件名 (e.g. OrderConfirmed)                    #}
{#     .description       — 事件描述                                         #}
{#     .payload_fields[]  — 载荷字段 { name, rust_type, description }        #}
{#   entity.enums[]       — 含 is_state_machine 的枚举（自动生成转换事件）     #}
use serde::{Deserialize, Serialize};
use uuid::Uuid;

use erp_shared::events::ErpDomainEvent;

// ============ {{ entity.name }} Domain Events ============

{% for event in entity.events | default(value=[]) %}
/// {{ event.description | default(value=event.name) }}
///
/// 聚合根: {{ entity.name }}
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct {{ event.name }} {
{% for field in event.payload_fields | default(value=[]) %}
    /// {{ field.description | default(value=field.name) }}
    pub {{ field.name }}: {{ field.rust_type }},
{% endfor %}
}

impl {{ event.name }} {
    /// 包装为 ErpDomainEvent
    pub fn into_erp_event(self, aggregate_id: Uuid) -> ErpDomainEvent {
        ErpDomainEvent::from_typed(
            "{{ entity.name | snake_case }}.{{ event.name | snake_case }}",
            aggregate_id,
            &self,
        )
    }
}

{% endfor %}

{# 自动为 state machine 枚举生成转换事件 #}
{% for enum in entity.enums | default(value=[]) %}
{% if enum.is_state_machine | default(value=false) %}
// ── Auto-generated transition events for {{ enum.rust_enum_name }} ──

{% for variant in enum.variants %}
{% set transitions = enum.transitions[variant.name] | default(value=[]) %}
{% for target in transitions %}
/// {{ entity.name }} 从 {{ variant.pascal_case }} → {{ target }} 转换事件
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct {{ entity.name }}{{ variant.pascal_case }}To{{ target }} {
    pub {{ entity.name | snake_case }}_id: Uuid,
    pub reason: Option<String>,
}

impl {{ entity.name }}{{ variant.pascal_case }}To{{ target }} {
    pub fn into_erp_event(self, aggregate_id: Uuid) -> ErpDomainEvent {
        ErpDomainEvent::from_typed(
            "{{ entity.name | snake_case }}.{{ variant.name | snake_case }}_to_{{ target | snake_case }}",
            aggregate_id,
            &self,
        )
    }
}

{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}

// <<< block:custom_events
// 在这里添加自定义领域事件（会在重新生成时保留）
// >>> end:custom_events

#[cfg(test)]
mod tests {
    use super::*;

{% for event in entity.events | default(value=[]) %}
{% if loop.first %}
    #[test]
    fn test_{{ event.name | snake_case }}_into_erp_event() {
        let event = {{ event.name }} {
{% for field in event.payload_fields | default(value=[]) %}
{% if field.rust_type == "Uuid" %}
            {{ field.name }}: Uuid::new_v4(),
{% elif field.rust_type == "String" %}
            {{ field.name }}: "test".to_string(),
{% elif field.rust_type == "Option<String>" %}
            {{ field.name }}: Some("test".to_string()),
{% elif field.rust_type == "f64" %}
            {{ field.name }}: 1.0,
{% else %}
            {{ field.name }}: Default::default(),
{% endif %}
{% endfor %}
        };
        let erp_event = event.into_erp_event(Uuid::new_v4());
        assert_eq!(
            erp_event.event_type,
            "{{ entity.name | snake_case }}.{{ event.name | snake_case }}"
        );
    }
{% endif %}
{% endfor %}
}
