/// Result of create {{ entity.description | default(value=entity.name) }} command
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Create{{ entity_pascal }}Result {
    /// Created {{ entity.name }} ID
    pub {{ entity_snake }}_id: Uuid,
{% if entity.schema == "sys" or  "tenant" in entity.table_name  %}
    /// Tenant ID
    pub tenant_id: String,
{% endif %}
}

impl Create{{ entity_pascal }}Result {
    pub fn new(
        {{ entity_snake }}_id: Uuid,
{% if entity.schema == "sys" or  "tenant" in entity.table_name  %}
        tenant_id: String,
{% endif %}
