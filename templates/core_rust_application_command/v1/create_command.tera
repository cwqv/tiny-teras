pub struct Create{{ entity_pascal }}Command {
{% for field in entity.fields %}
{% if not field.primary_key and not field.name in entity.hidden_fields %}
{% if field.name == "created_at" or field.name == "updated_at" or field.name == "created_by" or field.name == "updated_by" %}
{% continue %}
{% endif %}
    /// {{ field.description | default(value=field.name) }}
    pub {{ field.name | snake_case }}: {{ field.rust_type }},
{% endif %}
{% endfor %}
}

impl Create{{ entity_pascal }}Command {
    pub fn new(
{% for field in entity.fields %}
{% if not field.primary_key and not field.name in entity.hidden_fields %}
