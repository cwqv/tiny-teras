-- ============================================================
-- Create {{ entity.schema }}.{{ entity.table_name }}
-- File: {{ migration_timestamp }}_create_{{ entity.schema }}_{{ entity.table_name }}.sql
-- Purpose:
--   - Create {{ entity.name }} entity table under schema `{{ entity.schema }}`
{%- if entity.migration_dependencies is defined and entity.migration_dependencies | length > 0 %}
-- Dependencies:
  {%- for dep in entity.migration_dependencies %}
--   - {{ dep }}
  {%- endfor %}
{%- endif %}
-- Notes:
--   - Generated by Tiny Tera
-- ============================================================

BEGIN;

-- Ensure schema exists (idempotent safety)
CREATE SCHEMA IF NOT EXISTS {{ entity.schema }};

-- Set search_path
{%- if entity.search_path is defined and entity.search_path | length > 0 %}
SET LOCAL search_path = {%- for path in entity.search_path -%}{{ path }}{% if not loop.last %}, {% endif %}{%- endfor %};
{%- else %}
SET LOCAL search_path = {{ entity.schema }}, public, extensions;
{%- endif %}

{%- if entity.enums is defined and entity.enums | length > 0 %}
-- ------------------------------------------------------------
-- Enum Types
-- ------------------------------------------------------------
{% for enum in entity.enums %}
-- Create enum type: {{ enum.name }}
DO $$ BEGIN
    CREATE TYPE {{ entity.schema }}.{{ enum.snake_case }} AS ENUM (
        {%- for variant in enum.variants %}
        '{{ variant.value | as_str | default(value=variant.snake_case) }}'{% if not loop.last %},{% endif %}
        {%- endfor %}
    );
EXCEPTION
    WHEN duplicate_object THEN null;
END $$;

COMMENT ON TYPE {{ entity.schema }}.{{ enum.snake_case }} IS '{{ enum.description | default(value=enum.name) }}';

{% endfor %}
{%- endif %}

-- ------------------------------------------------------------
-- Table: {{ entity.schema }}.{{ entity.table_name }}
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS {{ entity.schema }}.{{ entity.table_name }} (
{% for field in entity.fields -%}
  {%- set is_enum = false %}
  {%- set enum_type = "" %}
  {%- if entity.enums is defined and field.type is defined %}
    {%- for enum in entity.enums %}
      {%- if (field.type == enum.name) or (field.rust_type is defined and field.rust_type == enum.rust_enum_name) %}
        {%- set is_enum = true %}
        {%- set enum_type = entity.schema ~ "." ~ enum.snake_case %}
        {%- break %}
      {%- endif %}
    {%- endfor %}
  {%- endif %}
  {{ field.name }} {% if is_enum %}{{ enum_type }}{% else %}{{ field.sql_type }}{% endif %}{% if field.primary_key %} PRIMARY KEY{% endif %}{% if field.nullable == false and not field.primary_key %} NOT NULL{% endif %}{% if field.default %} DEFAULT {% if field.type == "bool" %}{% if field.default == "true" %}TRUE{% else %}FALSE{% endif %}{% elif field.type == "i32" or field.type == "usize" %}{{ field.default }}{% elif field.type == "Json" %}'{}'::jsonb{% elif field.type == "Timestamp" %}NOW(){% else %}'{{ field.default }}'{% endif %}{% endif %}{% if not loop.last %},{% endif %}
{% endfor -%}
{%- if entity.constraints is defined and entity.constraints | length > 0 %}
  -- Constraints
  {%- for constraint in entity.constraints %}
  , CONSTRAINT {{ constraint.name }} CHECK ({{ constraint.expression }})
  {%- endfor %}
{%- endif %}
);

-- Foreign key constraints (from Phase 4 foreign_key config)
{%- for field in entity.fields %}
{%- if field.foreign_key is defined and field.foreign_key.target_table is defined %}
ALTER TABLE {{ entity.schema }}.{{ entity.table_name }}
  ADD CONSTRAINT fk_{{ entity.table_name }}_{{ field.name }}
  FOREIGN KEY ({{ field.name }})
  REFERENCES {{ field.foreign_key.target_schema | default(value="sys") }}.{{ field.foreign_key.target_table }}({{ field.foreign_key.target_field | default(value="id") }})
  {%- if field.foreign_key.on_delete is defined %}
  ON DELETE {{ field.foreign_key.on_delete }}
  {%- endif %}
  {%- if field.foreign_key.on_update is defined %}
  ON UPDATE {{ field.foreign_key.on_update }}
  {%- endif %};
{% endif -%}
{%- endfor %}

-- Unique constraints
{% for field in entity.fields -%}
{% if field.unique -%}
CREATE UNIQUE INDEX IF NOT EXISTS ux_{{ entity.schema }}_{{ entity.table_name }}_{{ field.name }} ON {{ entity.schema }}.{{ entity.table_name }} ({{ field.name }});
{% endif -%}
{% endfor %}

-- Common query indexes
{%- if entity.indexed_fields is defined and entity.indexed_fields | length > 0 %}
  {%- for indexed_field in entity.indexed_fields %}
CREATE INDEX IF NOT EXISTS ix_{{ entity.schema }}_{{ entity.table_name }}_{{ indexed_field }} ON {{ entity.schema }}.{{ entity.table_name }} ({{ indexed_field }});
  {%- endfor %}
{%- endif %}

-- Comments
COMMENT ON TABLE {{ entity.schema }}.{{ entity.table_name }} IS '{{ entity.description }}';
{% for field in entity.fields -%}
{% if field.description -%}
COMMENT ON COLUMN {{ entity.schema }}.{{ entity.table_name }}.{{ field.name }} IS '{{ field.description }}';
{% endif -%}
{% endfor %}

{%- if entity.relationships is defined and entity.relationships | length > 0 %}
-- ------------------------------------------------------------
-- Junction Tables (for many_to_many relationships)
-- ------------------------------------------------------------
{% for relationship in entity.relationships %}
{% if relationship.relation_type == "ManyToMany" or relationship.relation_type == "many_to_many" %}
{% if relationship.junction_table is defined %}
-- Junction table: {{ relationship.junction_table.table_name }}
CREATE TABLE IF NOT EXISTS {{ entity.schema }}.{{ relationship.junction_table.table_name }} (
    {{ relationship.junction_table.source_field }} UUID NOT NULL,
    {{ relationship.junction_table.target_field }} UUID NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    PRIMARY KEY ({{ relationship.junction_table.source_field }}, {{ relationship.junction_table.target_field }}),
    CONSTRAINT fk_{{ relationship.junction_table.table_name }}_source
        FOREIGN KEY ({{ relationship.junction_table.source_field }})
        REFERENCES {{ entity.schema }}.{{ entity.table_name }}(id)
        ON DELETE CASCADE,
    CONSTRAINT fk_{{ relationship.junction_table.table_name }}_target
        FOREIGN KEY ({{ relationship.junction_table.target_field }})
        REFERENCES {{ relationship.target_entity | snake_case }}(id)
        ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS ix_{{ relationship.junction_table.table_name }}_source ON {{ entity.schema }}.{{ relationship.junction_table.table_name }} ({{ relationship.junction_table.source_field }});
CREATE INDEX IF NOT EXISTS ix_{{ relationship.junction_table.table_name }}_target ON {{ entity.schema }}.{{ relationship.junction_table.table_name }} ({{ relationship.junction_table.target_field }});

COMMENT ON TABLE {{ entity.schema }}.{{ relationship.junction_table.table_name }} IS 'Junction table for {{ relationship.name }} relationship';
{% endif %}
{% endif %}
{% endfor %}
{%- endif %}

COMMIT;

-- ============================================================
-- Rollback (manual)
-- ============================================================
-- BEGIN;
-- DROP TABLE IF EXISTS {{ entity.schema }}.{{ entity.table_name }};
-- COMMIT;
