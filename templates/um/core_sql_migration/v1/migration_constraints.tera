{#- 
  SQL Migration - Constraints Template
  Generates SQL migration for adding/modifying constraints
  Supports: foreign keys, unique constraints, check constraints
-#}
-- ============================================================
-- Add/Modify Constraints for {{ entity.schema }}.{{ entity.table_name }}
-- File: {{ migration_timestamp }}_constraints_{{ entity.schema }}_{{ entity.table_name }}.sql
-- Purpose:
--   - Add or modify table constraints
{%- if migration_description %}
--   - {{ migration_description }}
{%- endif %}
{%- if entity.migration_dependencies is defined and entity.migration_dependencies | length > 0 %}
-- Dependencies:
  {%- for dep in entity.migration_dependencies %}
--   - {{ dep }}
  {%- endfor %}
{%- endif %}
-- Notes:
--   - Generated by Tiny Tera
-- ============================================================

BEGIN;

-- Set search_path
{%- if entity.search_path is defined and entity.search_path | length > 0 %}
SET LOCAL search_path = {%- for path in entity.search_path -%}{{ path }}{% if not loop.last %}, {% endif %}{%- endfor %};
{%- else %}
SET LOCAL search_path = {{ entity.schema }}, public, extensions;
{%- endif %}

{%- if constraints.foreign_keys is defined and constraints.foreign_keys | length > 0 %}

-- ------------------------------------------------------------
-- Foreign Key Constraints
-- ------------------------------------------------------------
{%- for fk in constraints.foreign_keys %}
ALTER TABLE {{ entity.schema }}.{{ entity.table_name }}
  ADD CONSTRAINT {{ fk.name | default(value="fk_" ~ entity.table_name ~ "_" ~ fk.column) }}
  FOREIGN KEY ({{ fk.column }})
  REFERENCES {{ fk.target_schema | default(value="sys") }}.{{ fk.target_table }}({{ fk.target_column | default(value="id") }})
  {%- if fk.on_delete %}
  ON DELETE {{ fk.on_delete }}
  {%- endif %}
  {%- if fk.on_update %}
  ON UPDATE {{ fk.on_update }}
  {%- endif %};
{% endfor %}
{%- endif %}

{%- if constraints.unique_constraints is defined and constraints.unique_constraints | length > 0 %}

-- ------------------------------------------------------------
-- Unique Constraints
-- ------------------------------------------------------------
{%- for uc in constraints.unique_constraints %}
ALTER TABLE {{ entity.schema }}.{{ entity.table_name }}
  ADD CONSTRAINT {{ uc.name | default(value="uc_" ~ entity.table_name ~ "_" ~ uc.columns | join(sep="_")) }}
  UNIQUE ({{ uc.columns | join(sep=", ") }});
{% endfor %}
{%- endif %}

{%- if constraints.check_constraints is defined and constraints.check_constraints | length > 0 %}

-- ------------------------------------------------------------
-- Check Constraints
-- ------------------------------------------------------------
{%- for cc in constraints.check_constraints %}
ALTER TABLE {{ entity.schema }}.{{ entity.table_name }}
  ADD CONSTRAINT {{ cc.name | default(value="chk_" ~ entity.table_name ~ "_" ~ loop.index) }}
  CHECK ({{ cc.expression }});
{% endfor %}
{%- endif %}

{%- if constraints.indexes is defined and constraints.indexes | length > 0 %}

-- ------------------------------------------------------------
-- Indexes (for performance)
-- ------------------------------------------------------------
{%- for idx in constraints.indexes %}
CREATE {% if idx.unique %}UNIQUE {% endif %}INDEX IF NOT EXISTS {{ idx.name | default(value="idx_" ~ entity.table_name ~ "_" ~ idx.columns | join(sep="_")) }}
  ON {{ entity.schema }}.{{ entity.table_name }}
  {%- if idx.using %} USING {{ idx.using }}{% endif %}
  ({{ idx.columns | join(sep=", ") }})
  {%- if idx.where %} WHERE {{ idx.where }}{% endif %};
{% endfor %}
{%- endif %}

-- <<< block:custom_constraints
-- Add custom constraints here
-- >>> end:custom_constraints

COMMIT;

-- ============================================================
-- Rollback (manual)
-- ============================================================
-- BEGIN;
{%- if constraints.foreign_keys is defined and constraints.foreign_keys | length > 0 %}
{%- for fk in constraints.foreign_keys %}
-- ALTER TABLE {{ entity.schema }}.{{ entity.table_name }} DROP CONSTRAINT IF EXISTS {{ fk.name | default(value="fk_" ~ entity.table_name ~ "_" ~ fk.column) }};
{%- endfor %}
{%- endif %}
{%- if constraints.unique_constraints is defined and constraints.unique_constraints | length > 0 %}
{%- for uc in constraints.unique_constraints %}
-- ALTER TABLE {{ entity.schema }}.{{ entity.table_name }} DROP CONSTRAINT IF EXISTS {{ uc.name | default(value="uc_" ~ entity.table_name ~ "_" ~ uc.columns | join(sep="_")) }};
{%- endfor %}
{%- endif %}
{%- if constraints.check_constraints is defined and constraints.check_constraints | length > 0 %}
{%- for cc in constraints.check_constraints %}
-- ALTER TABLE {{ entity.schema }}.{{ entity.table_name }} DROP CONSTRAINT IF EXISTS {{ cc.name | default(value="chk_" ~ entity.table_name ~ "_" ~ loop.index) }};
{%- endfor %}
{%- endif %}
{%- if constraints.indexes is defined and constraints.indexes | length > 0 %}
{%- for idx in constraints.indexes %}
-- DROP INDEX IF EXISTS {{ entity.schema }}.{{ idx.name | default(value="idx_" ~ entity.table_name ~ "_" ~ idx.columns | join(sep="_")) }};
{%- endfor %}
{%- endif %}
-- COMMIT;
