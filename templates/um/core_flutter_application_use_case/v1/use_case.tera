import 'package:shared_application/shared_application.dart';

import '../../domain/entities/{{ entity.name | snake_case }}.dart';
import '../../domain/repositories/{{ entity.name | snake_case }}_repository.dart';
import '../dto/{{ entity.name | snake_case }}_dto.dart';

{%- if entity.service_methods is defined and entity.service_methods | length > 0 %}
{# 使用 service_methods 循环生成 UseCase 类 #}
{%- for method in entity.service_methods %}
{%- if method.name == "Get" %}
// ============ {{ method.use_case_class }} ============

/// {{ method.description }}的用例
class {{ method.use_case_class }} extends AsyncUseCase<Get{{ entity.name }}Dto, {{ entity.name }}, Failure> {
  final {{ entity.name }}Repository _repository;

  {{ method.use_case_class }}(this._repository);

  @override
  Future<Result<{{ entity.name }}, Failure>> execute(Get{{ entity.name }}Dto input) async {
    try {
{%- if entity.dto_fields.get is defined %}
      final result = await _repository.findById(
{%- for field in entity.dto_fields.get %}
  {%- if field.name is defined %}
    {%- if field.primary_key %}
        {{ field.name }}: input.{{ field.name }},
    {%- endif %}
  {%- else %}
    {%- if field == "id" %}
        id: input.id,
    {%- endif %}
  {%- endif %}
{%- endfor %}
{%- if features.multi_tenant %}
        tenantId: input.tenantId,
{%- endif %}
      );
{%- else %}
      // TODO: 配置 dto_fields.get 以生成正确的查询逻辑
      throw UnimplementedError('Get{{ entity.name }}Dto fields not configured');
{%- endif %}

      return result.fold(
        (entity) {
          if (entity == null) {
            return FailureResult(NotFoundFailure(
              message: '{{ entity.name }}未找到',
              code: '{{ entity.name | upper }}_NOT_FOUND',
            ));
          }
          return Success(entity);
        },
        (failure) => FailureResult(failure),
      );
    } catch (e, st) {
      return FailureResult(UnknownFailure(
        message: '获取{{ entity.name }}时发生错误: $e',
        code: 'GET_{{ entity.name | upper }}_ERROR',
        cause: e,
        stackTrace: st,
      ));
    }
  }
}

{%- elif method.name == "List" %}
// ============ {{ method.use_case_class }} ============

/// {{ method.description }}的用例
class {{ method.use_case_class }} extends AsyncUseCase<List{{ entity.name }}sDto, List<{{ entity.name }}>, Failure> {
  final {{ entity.name }}Repository _repository;

  {{ method.use_case_class }}(this._repository);

  @override
  Future<Result<List<{{ entity.name }}>, Failure>> execute(List{{ entity.name }}sDto input) async {
    try {
{%- if features.search %}
      final result = await _repository.search(
{%- if features.multi_tenant %}
        tenantId: input.tenantId,
{%- endif %}
{%- if entity.dto_fields.list is defined %}
{%- for field in entity.dto_fields.list %}
  {%- if field.name is defined %}
    {%- if field.name == "search_query" %}
        searchQuery: input.searchQuery,
    {%- elif field.name == "roles" %}
        roles: input.roles,
    {%- elif field.name == "is_active" %}
        isActive: input.isActive,
    {%- elif field.name == "limit" %}
        limit: input.limit,
    {%- elif field.name == "offset" %}
        offset: input.offset,
    {%- endif %}
  {%- else %}
    {%- if field == "search_query" %}
        searchQuery: input.searchQuery,
    {%- elif field == "roles" %}
        roles: input.roles,
    {%- elif field == "is_active" %}
        isActive: input.isActive,
    {%- elif field == "limit" %}
        limit: input.limit,
    {%- elif field == "offset" %}
        offset: input.offset,
    {%- endif %}
  {%- endif %}
{%- endfor %}
{%- endif %}
      );
{%- else %}
{%- if features.multi_tenant %}
      final result = await _repository.listByTenant(
        tenantId: input.tenantId!,
      );
{%- else %}
      final result = await _repository.listAll();
{%- endif %}
{%- endif %}
      
      return result.fold(
        (entities) => Success(entities),
        (failure) => FailureResult(failure),
      );
    } catch (e, st) {
      return FailureResult(UnknownFailure(
        message: '列出{{ entity.name }}时发生错误: $e',
        code: 'LIST_{{ entity.name | upper }}S_ERROR',
        cause: e,
        stackTrace: st,
      ));
    }
  }
}

