{%- elif method.name == "Create" %}
// ============ {{ method.use_case_class }} ============

/// {{ method.description }}的用例
class {{ method.use_case_class }} extends AsyncUseCase<Create{{ entity.name }}Dto, Created{{ entity.name }}Dto, Failure> {
  final {{ entity.name }}Repository _repository;

  {{ method.use_case_class }}(this._repository);

  @override
  Future<Result<Created{{ entity.name }}Dto, Failure>> execute(Create{{ entity.name }}Dto input) async {
    try {
{%- if entity.dto_fields.create is defined and entity.dto_fields.create | length > 0 %}
      // 验证输入
{%- for field in entity.dto_fields.create %}
  {%- if field.name is defined %}
    {%- if field.type == "Email" %}
      if (input.{{ field.name }} == null || input.{{ field.name }}!.isEmpty) {
        return FailureResult(ValidationFailure(
          message: '邮箱不能为空',
          code: 'EMAIL_REQUIRED',
        ));
      }
    {%- elif field.name == "password" %}
      if (input.{{ field.name }} == null || input.{{ field.name }}!.length < 8) {
        return FailureResult(ValidationFailure(
          message: '密码长度至少8位',
          code: 'PASSWORD_TOO_SHORT',
        ));
      }
    {%- endif %}
  {%- else %}
    {%- if field == "email" %}
      if (input.email == null || input.email!.isEmpty) {
        return FailureResult(ValidationFailure(
          message: '邮箱不能为空',
          code: 'EMAIL_REQUIRED',
        ));
      }
    {%- elif field == "password" %}
      if (input.password == null || input.password!.length < 8) {
        return FailureResult(ValidationFailure(
          message: '密码长度至少8位',
          code: 'PASSWORD_TOO_SHORT',
        ));
      }
    {%- endif %}
  {%- endif %}
{%- endfor %}

      // 创建{{ entity.name }}实体
      final {{ entity.name | snake_case }} = {{ entity.name }}(
        id: '', // 将由服务器生成
        createdAt: DateTime.now().toUtc(),
        updatedAt: DateTime.now().toUtc(),
{%- if features.multi_tenant %}
        tenantId: input.tenantId!,
{%- endif %}
{%- for field in entity.dto_fields.create %}
  {%- if field.name is defined %}
    {%- if field.name != "tenant_id" and field.name != "password" %}
        {{ field.name }}: input.{{ field.name }}{% if field.type == "Email" %}!{% endif %},
    {%- elif field.name == "password" %}
        // password_hash 将由服务器处理
    {%- endif %}
  {%- else %}
    {%- if field != "tenant_id" and field != "password" %}
        // {{ field }}: input.{{ field }},
    {%- endif %}
  {%- endif %}
{%- endfor %}
      );

      // 保存到仓储
      final result = await _repository.upsert({{ entity.name | snake_case }});
      
      return result.fold(
        (entity) => Success(Created{{ entity.name }}Dto(
{%- for field in entity.fields %}
  {%- if field.primary_key %}
          {{ field.name }}: entity.id,
  {%- endif %}
{%- endfor %}
{%- if features.multi_tenant %}
          tenantId: entity.tenantId!,
{%- endif %}
        )),
        (failure) => FailureResult(failure),
      );
{%- else %}
      // TODO: 配置 dto_fields.create 以生成正确的创建逻辑
      throw UnimplementedError('Create{{ entity.name }}Dto fields not configured');
{%- endif %}
    } catch (e, st) {
      return FailureResult(UnknownFailure(
        message: '创建{{ entity.name }}时发生错误: $e',
        code: 'CREATE_{{ entity.name | upper }}_ERROR',
        cause: e,
        stackTrace: st,
      ));
    }
  }
}

{%- elif method.name == "Update" %}
// ============ {{ method.use_case_class }} ============

/// {{ method.description }}的用例
class {{ method.use_case_class }} extends AsyncUseCase<Update{{ entity.name }}Dto, {{ entity.name }}, Failure> {
  final {{ entity.name }}Repository _repository;

  {{ method.use_case_class }}(this._repository);

  @override
  Future<Result<{{ entity.name }}, Failure>> execute(Update{{ entity.name }}Dto input) async {
    try {
{%- if entity.dto_fields.update is defined and entity.dto_fields.update | length > 0 %}
      // 获取现有{{ entity.name }}
{%- for field in entity.dto_fields.update %}
  {%- if field.name is defined %}
    {%- if field.primary_key %}
      final getResult = await _repository.findById(
        {{ field.name }}: input.{{ field.name }}!,
{%- if features.multi_tenant %}
        tenantId: input.tenantId!,
{%- endif %}
      );

      final existingEntity = getResult.successOrNull;
      if (existingEntity == null) {
        return FailureResult(NotFoundFailure(
          message: '{{ entity.name }}未找到',
          code: '{{ entity.name | upper }}_NOT_FOUND',
        ));
      }

{%- if features.multi_tenant %}
      // 验证租户匹配
      if (existingEntity.tenantId != input.tenantId) {
        return FailureResult(AuthorizationFailure(
          message: '{{ entity.name }}不属于该租户',
          code: 'TENANT_MISMATCH',
        ));
      }

{%- endif %}
      // 更新字段
      var updatedEntity = existingEntity.copyWith(
{%- for update_field in entity.dto_fields.update %}
  {%- if update_field.name is defined %}
    {%- if not update_field.primary_key %}
        {{ update_field.name }}: input.{{ update_field.name }},
    {%- endif %}
  {%- else %}
    {%- if update_field != "id" and update_field != "tenant_id" and update_field != "password" %}
        {{ update_field }}: input.{{ update_field }},
    {%- endif %}
  {%- endif %}
{%- endfor %}
        updatedAt: DateTime.now().toUtc(),
      );

      // 保存更新
      final updateResult = await _repository.update(updatedEntity);
      
      return updateResult.fold(
        (entity) => Success(entity),
        (failure) => FailureResult(failure),
      );
    {%- endif %}
  {%- else %}
    {%- if field == "id" %}
      final getResult = await _repository.findById(
        id: input.id!,
{%- if features.multi_tenant %}
        tenantId: input.tenantId!,
{%- endif %}
      );

      final existingEntity = getResult.successOrNull;
      if (existingEntity == null) {
        return FailureResult(NotFoundFailure(
          message: '{{ entity.name }}未找到',
          code: '{{ entity.name | upper }}_NOT_FOUND',
        ));
      }

      // 更新字段
      var updatedEntity = existingEntity.copyWith(
{%- for update_field in entity.dto_fields.update %}
  {%- if update_field != "id" and update_field != "tenant_id" and update_field != "password" %}
        {{ update_field }}: input.{{ update_field }},
  {%- endif %}
{%- endfor %}
        updatedAt: DateTime.now().toUtc(),
      );

      // 保存更新
      final updateResult = await _repository.update(updatedEntity);
      
      return updateResult.fold(
        (entity) => Success(entity),
        (failure) => FailureResult(failure),
      );
    {%- endif %}
  {%- endif %}
{%- endfor %}
{%- else %}
      // TODO: 配置 dto_fields.update 以生成正确的更新逻辑
      throw UnimplementedError('Update{{ entity.name }}Dto fields not configured');
{%- endif %}
    } catch (e, st) {
      return FailureResult(UnknownFailure(
        message: '更新{{ entity.name }}时发生错误: $e',
        code: 'UPDATE_{{ entity.name | upper }}_ERROR',
        cause: e,
        stackTrace: st,
      ));
    }
  }
}

{%- elif method.name == "Delete" %}
// ============ {{ method.use_case_class }} ============

/// {{ method.description }}的用例
class {{ method.use_case_class }} extends AsyncUseCase<Delete{{ entity.name }}Dto, void, Failure> {
  final {{ entity.name }}Repository _repository;

  {{ method.use_case_class }}(this._repository);

  @override
  Future<Result<void, Failure>> execute(Delete{{ entity.name }}Dto input) async {
    try {
{%- if entity.dto_fields.delete is defined and entity.dto_fields.delete | length > 0 %}
      // 验证{{ entity.name }}存在{% if features.multi_tenant %}且属于该租户{% endif %}
{%- for field in entity.dto_fields.delete %}
  {%- if field.name is defined %}
    {%- if field.primary_key %}
      final getResult = await _repository.findById(
        {{ field.name }}: input.{{ field.name }},
{%- if features.multi_tenant %}
        tenantId: input.tenantId,
{%- endif %}
      );

      final existingEntity = getResult.successOrNull;
      if (existingEntity == null) {
        return FailureResult(NotFoundFailure(
          message: '{{ entity.name }}未找到',
          code: '{{ entity.name | upper }}_NOT_FOUND',
        ));
      }

{%- if features.multi_tenant %}
      // 验证租户匹配
      if (existingEntity.tenantId != input.tenantId) {
        return FailureResult(AuthorizationFailure(
          message: '{{ entity.name }}不属于该租户',
          code: 'TENANT_MISMATCH',
        ));
      }

{%- endif %}
      // 执行{% if features.soft_delete %}软{% endif %}删除
      final deleteResult = await _repository.delete(
{%- if features.multi_tenant %}
        tenantId: input.tenantId,
{%- endif %}
{%- for delete_field in entity.dto_fields.delete %}
  {%- if delete_field.name is defined %}
    {%- if delete_field.primary_key %}
        {{ delete_field.name }}: input.{{ delete_field.name }},
    {%- endif %}
  {%- endif %}
{%- endfor %}
      );
      
      return deleteResult.fold(
        (_) => const Success(null),
        (failure) => FailureResult(failure),
      );
    {%- endif %}
  {%- else %}
    {%- if field == "id" %}
      final getResult = await _repository.findById(
        id: input.id,
{%- if features.multi_tenant %}
        tenantId: input.tenantId,
{%- endif %}
      );

      final existingEntity = getResult.successOrNull;
      if (existingEntity == null) {
        return FailureResult(NotFoundFailure(
          message: '{{ entity.name }}未找到',
          code: '{{ entity.name | upper }}_NOT_FOUND',
        ));
      }

      // 执行删除
      final deleteResult = await _repository.delete(
{%- if features.multi_tenant %}
        tenantId: input.tenantId,
{%- endif %}
        id: input.id,
      );
      
      return deleteResult.fold(
        (_) => const Success(null),
        (failure) => FailureResult(failure),
      );
    {%- endif %}
  {%- endif %}
{%- endfor %}
{%- else %}
      // TODO: 配置 dto_fields.delete 以生成正确的删除逻辑
      throw UnimplementedError('Delete{{ entity.name }}Dto fields not configured');
{%- endif %}
    } catch (e, st) {
      return FailureResult(UnknownFailure(
        message: '删除{{ entity.name }}时发生错误: $e',
        code: 'DELETE_{{ entity.name | upper }}_ERROR',
        cause: e,
        stackTrace: st,
      ));
    }
  }
}

