/// Application service for {{ entity.description | default(value=entity.name) }} management
///
/// This service orchestrates business operations for {{ entity.name }}s,
/// delegating to command/query handlers and coordinating cross-cutting concerns.
pub struct {{ entity_pascal }}Service<R>
where
    R: {{ entity_pascal }}Repository,
{
    create_handler: Create{{ entity_pascal }}CommandHandler<R>,
    get_handler: Get{{ entity_pascal }}QueryHandler<R>,
    list_handler: List{{ entity_pascal }}sQueryHandler<R>,
}

impl<R> {{ entity_pascal }}Service<R>
where
    R: {{ entity_pascal }}Repository,
{
    /// Create a new {{ entity.description | default(value=entity.name) }} service
    pub fn new(
        repo: Arc<R>,
{% if entity.name == "User" or  "Credential" in entity.name  %}
        auth_service: AuthenticationService,
{% endif %}
        event_service: Option<Arc<UnifiedEventService>>,
    ) -> Self {
        let mut create_handler = Create{{ entity_pascal }}CommandHandler::new(
            repo.clone(),
{% if entity.name == "User" or  "Credential" in entity.name  %}
            auth_service,
{% endif %}
        );

        if let Some(events) = event_service {
            create_handler = create_handler.with_event_service(events);
        }

        Self {
            create_handler,
            get_handler: Get{{ entity_pascal }}QueryHandler::new(repo.clone()),
            list_handler: List{{ entity_pascal }}sQueryHandler::new(repo.clone()),
        }
    }

    /// Create a new {{ entity.description | default(value=entity.name) }}
    pub async fn create(&self, command: Create{{ entity_pascal }}Command) -> ApplicationResult<Create{{ entity_pascal }}Result> {
        self.create_handler.execute(command).await
    }

    /// Get {{ entity.description | default(value=entity.name) }} by ID
    pub async fn get(&self, query: Get{{ entity_pascal }}Query) -> ApplicationResult<{{ entity_pascal }}> {
        self.get_handler.execute(query).await
    }

    /// List {{ entity.description | default(value=entity.name) }}s
    pub async fn list(&self, query: List{{ entity_pascal }}sQuery) -> ApplicationResult<Vec<{{ entity_pascal }}>> {
        self.list_handler.execute(query).await
    }

    // TODO: Add update and delete methods
    // pub async fn update(&self, command: Update{{ entity_pascal }}Command) -> ApplicationResult<()>
    // pub async fn delete(&self, command: Delete{{ entity_pascal }}Command) -> ApplicationResult<()>
}

