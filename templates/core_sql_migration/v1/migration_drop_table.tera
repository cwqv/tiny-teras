{#- 
  SQL Migration - Drop Table Template
  Generates SQL migration for dropping tables safely
-#}
-- ============================================================
-- Drop {{ entity.schema }}.{{ entity.table_name }}
-- File: {{ migration_timestamp }}_drop_{{ entity.schema }}_{{ entity.table_name }}.sql
-- Purpose:
--   - Drop {{ entity.name }} entity table
{%- if migration_description %}
--   - {{ migration_description }}
{%- endif %}
-- WARNING:
--   - This operation is DESTRUCTIVE and IRREVERSIBLE
--   - All data in the table will be lost
--   - Dependent objects (views, functions) may break
{%- if entity.migration_dependencies is defined and entity.migration_dependencies | length > 0 %}
-- Dependencies:
  {%- for dep in entity.migration_dependencies %}
--   - {{ dep }}
  {%- endfor %}
{%- endif %}
-- Notes:
--   - Generated by Tiny Tera
--   - REVIEW CAREFULLY before applying
--   - Consider backing up data first
-- ============================================================

BEGIN;

-- Set search_path
{%- if entity.search_path is defined and entity.search_path | length > 0 %}
SET LOCAL search_path = {%- for path in entity.search_path -%}{{ path }}{% if not loop.last %}, {% endif %}{%- endfor %};
{%- else %}
SET LOCAL search_path = {{ entity.schema }}, public, extensions;
{%- endif %}

-- <<< block:custom_pre_drop
-- Add custom pre-drop SQL here (e.g., data backup)
-- >>> end:custom_pre_drop

-- Drop dependent objects first (if any)
{%- if drop_views is defined and drop_views | length > 0 %}
-- Drop dependent views
{%- for view_name in drop_views %}
DROP VIEW IF EXISTS {{ entity.schema }}.{{ view_name }} CASCADE;
{%- endfor %}
{%- endif %}

{%- if drop_functions is defined and drop_functions | length > 0 %}
-- Drop dependent functions
{%- for function in drop_functions %}
DROP FUNCTION IF EXISTS {{ entity.schema }}.{{ function }} CASCADE;
{%- endfor %}
{%- endif %}

-- Drop the table
DROP TABLE IF EXISTS {{ entity.schema }}.{{ entity.table_name }} CASCADE;

-- Drop schema if empty (optional, commented by default)
-- DO $$
-- BEGIN
--   IF NOT EXISTS (
--     SELECT 1 FROM information_schema.tables
--     WHERE table_schema = '{{ entity.schema }}'
--     LIMIT 1
--   ) THEN
--     DROP SCHEMA {{ entity.schema }};
--   END IF;
-- END $$;

-- <<< block:custom_post_drop
-- Add custom post-drop SQL here
-- >>> end:custom_post_drop

COMMIT;

-- ============================================================
-- Rollback (manual recreation)
-- ============================================================
-- To rollback this drop, you would need to:
-- 1. Restore from backup
-- 2. Re-run the original CREATE TABLE migration
-- 3. Re-import data from backup
--
-- Example:
-- BEGIN;
-- CREATE TABLE {{ entity.schema }}.{{ entity.table_name }} (
--   -- ... column definitions from original migration
-- );
-- -- Restore data from backup
-- COMMIT;
