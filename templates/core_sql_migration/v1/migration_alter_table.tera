{#- 
  SQL Migration - Alter Table Template
  Generates SQL migration for table alterations
  Supports: add column, drop column, rename column, modify column type
-#}
-- ============================================================
-- Alter {{ entity.schema }}.{{ entity.table_name }}
-- File: {{ migration_timestamp }}_alter_{{ entity.schema }}_{{ entity.table_name }}.sql
-- Purpose:
--   - Modify {{ entity.name}} entity table structure
{%- if migration_description %}
--   - {{ migration_description }}
{%- endif %}
{%- if entity.migration_dependencies is defined and entity.migration_dependencies | length > 0 %}
-- Dependencies:
  {%- for dep in entity.migration_dependencies %}
--   - {{ dep }}
  {%- endfor %}
{%- endif %}
-- Notes:
--   - Generated by Tiny Tera
--   - Review carefully before applying
-- ============================================================

BEGIN;

-- Set search_path
{%- if entity.search_path is defined and entity.search_path | length > 0 %}
SET LOCAL search_path = {%- for path in entity.search_path -%}{{ path }}{% if not loop.last %}, {% endif %}{%- endfor %};
{%- else %}
SET LOCAL search_path = {{ entity.schema }}, public, extensions;
{%- endif %}

-- <<< block:custom_pre_migration
-- Add custom pre-migration SQL here
-- >>> end:custom_pre_migration

{%- if alterations.add_columns is defined and alterations.add_columns | length > 0 %}

-- ------------------------------------------------------------
-- Add Columns
-- ------------------------------------------------------------
{%- for column in alterations.add_columns %}
ALTER TABLE {{ entity.schema }}.{{ entity.table_name }}
  ADD COLUMN {{ column.name }} {{ column.sql_type }}{% if column.nullable == false %} NOT NULL{% endif %}{% if column.default %} DEFAULT {% if column.type == "bool" %}{% if column.default == "true" %}TRUE{% else %}FALSE{% endif %}{% elif column.type == "i32" or column.type == "usize" %}{{ column.default }}{% elif column.type == "Json" %}'{}'::jsonb{% elif column.type == "Timestamp" %}NOW(){% else %}'{{ column.default }}'{% endif %}{% endif %};
{%- if column.description %}
COMMENT ON COLUMN {{ entity.schema }}.{{ entity.table_name }}.{{ column.name }} IS '{{ column.description }}';
{%- endif %}
{% endfor %}
{%- endif %}

{%- if alterations.drop_columns is defined and alterations.drop_columns | length > 0 %}

-- ------------------------------------------------------------
-- Drop Columns
-- ------------------------------------------------------------
{%- for column_name in alterations.drop_columns %}
ALTER TABLE {{ entity.schema }}.{{ entity.table_name }}
  DROP COLUMN IF EXISTS {{ column_name }};
{% endfor %}
{%- endif %}

{%- if alterations.rename_columns is defined and alterations.rename_columns | length > 0 %}

-- ------------------------------------------------------------
-- Rename Columns
-- ------------------------------------------------------------
{%- for rename in alterations.rename_columns %}
ALTER TABLE {{ entity.schema }}.{{ entity.table_name }}
  RENAME COLUMN {{ rename.old_name }} TO {{ rename.new_name }};
{% endfor %}
{%- endif %}

{%- if alterations.modify_columns is defined and alterations.modify_columns | length > 0 %}

-- ------------------------------------------------------------
-- Modify Column Types
-- ------------------------------------------------------------
{%- for modify in alterations.modify_columns %}
ALTER TABLE {{ entity.schema }}.{{ entity.table_name }}
  ALTER COLUMN {{ modify.name }} TYPE {{ modify.new_sql_type }}{% if modify.using %} USING {{ modify.using }}{% endif %};
{%- if modify.set_not_null %}
ALTER TABLE {{ entity.schema }}.{{ entity.table_name }}
  ALTER COLUMN {{ modify.name }} SET NOT NULL;
{%- endif %}
{%- if modify.set_default %}
ALTER TABLE {{ entity.schema }}.{{ entity.table_name }}
  ALTER COLUMN {{ modify.name }} SET DEFAULT {{ modify.set_default }};
{%- endif %}
{% endfor %}
{%- endif %}

{%- if alterations.add_constraints is defined and alterations.add_constraints | length > 0 %}

-- ------------------------------------------------------------
-- Add Constraints
-- ------------------------------------------------------------
{%- for constraint in alterations.add_constraints %}
ALTER TABLE {{ entity.schema }}.{{ entity.table_name }}
  ADD CONSTRAINT {{ constraint.name }} CHECK ({{ constraint.expression }});
{% endfor %}
{%- endif %}

{%- if alterations.drop_constraints is defined and alterations.drop_constraints | length > 0 %}

-- ------------------------------------------------------------
-- Drop Constraints
-- ------------------------------------------------------------
{%- for constraint_name in alterations.drop_constraints %}
ALTER TABLE {{ entity.schema }}.{{ entity.table_name }}
  DROP CONSTRAINT IF EXISTS {{ constraint_name }};
{% endfor %}
{%- endif %}

{%- if alterations.add_indexes is defined and alterations.add_indexes | length > 0 %}

-- ------------------------------------------------------------
-- Add Indexes
-- ------------------------------------------------------------
{%- for index in alterations.add_indexes %}
CREATE INDEX IF NOT EXISTS {{ index.name }} ON {{ entity.schema }}.{{ entity.table_name }} ({{ index.columns | join(sep=", ") }});
{% endfor %}
{%- endif %}

{%- if alterations.drop_indexes is defined and alterations.drop_indexes | length > 0 %}

-- ------------------------------------------------------------
-- Drop Indexes
-- ------------------------------------------------------------
{%- for index_name in alterations.drop_indexes %}
DROP INDEX IF EXISTS {{ entity.schema }}.{{ index_name }};
{% endfor %}
{%- endif %}

-- <<< block:custom_post_migration
-- Add custom post-migration SQL here
-- >>> end:custom_post_migration

COMMIT;

-- ============================================================
-- Rollback (manual)
-- ============================================================
-- BEGIN;
{%- if alterations.add_columns is defined and alterations.add_columns | length > 0 %}
{%- for column in alterations.add_columns %}
-- ALTER TABLE {{ entity.schema }}.{{ entity.table_name }} DROP COLUMN IF EXISTS {{ column.name }};
{%- endfor %}
{%- endif %}
{%- if alterations.drop_columns is defined and alterations.drop_columns | length > 0 %}
{%- for column_name in alterations.drop_columns %}
-- ALTER TABLE {{ entity.schema }}.{{ entity.table_name }} ADD COLUMN {{ column_name }} <type> <constraints>;
{%- endfor %}
{%- endif %}
-- COMMIT;
