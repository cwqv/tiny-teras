mod tests {
    use super::*;

    #[test]
    fn test_new_defaults() {
        // TODO: 补充 new() 测试
    }

    #[test]
    fn test_validate_empty_name() {
        // TODO: 补充必填字段验证测试
    }

    // <<< block:custom_tests
    // 自定义测试（手工补充）
    // >>> end:custom_tests
}
