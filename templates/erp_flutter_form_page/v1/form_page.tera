{# ERP Flutter Form Page 模板 — 生成含 line editor 的表单页 #}
{# 预期 YAML 变量:                                                               #}
{#   entity.name             — Header 实体名 (e.g. SaleOrder)                    #}
{#   entity.fields[]         — Header 字段列表                                    #}
{#   entity.enums[]          — 枚举列表                                           #}
{#   entity.features         — 特性开关                                           #}
{#   entity.line_entity      — Line 实体配置 (可选)                               #}
{#     .name                 — Line 实体名 (e.g. SaleOrderLine)                  #}
{#     .fields[]             — Line 字段列表                                      #}
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../domain/entities/{{ entity.name | snake_case }}.dart';
{% if entity.line_entity is defined %}
import '../../domain/entities/{{ entity.line_entity.name | snake_case }}.dart';
{% endif %}
import '../providers/{{ entity.name | snake_case }}_providers.dart';

/// {{ entity.name }} 表单页面（ERP 风格 — 含明细行编辑器）
class {{ entity.name }}FormPage extends ConsumerStatefulWidget {
{% if entity.features.tenant_aware | default(value=false) %}
  final String tenantId;
{% endif %}
  final {{ entity.name }}? entity;

  const {{ entity.name }}FormPage({
    super.key,
{% if entity.features.tenant_aware | default(value=false) %}
    required this.tenantId,
{% endif %}
    this.entity,
  });

  @override
  ConsumerState<{{ entity.name }}FormPage> createState() => _{{ entity.name }}FormPageState();
}

class _{{ entity.name }}FormPageState extends ConsumerState<{{ entity.name }}FormPage> {
  final _formKey = GlobalKey<FormState>();
  bool _isLoading = false;

  // ── Header 字段控制器 ──
{% for field in entity.fields %}
{% set skip = field.primary_key or field.name == "tenant_id" or field.name == "created_at" or field.name == "updated_at" or field.name == "created_by" or field.name == "updated_by" or field.name == "version" %}
{% if not skip %}
{% if field.type == "bool" %}
  bool _{{ field.name }} = {{ field.default | default(value="false") }};
{% else %}
  final _{{ field.name }}Controller = TextEditingController();
{% endif %}
{% endif %}
{% endfor %}

{% if entity.line_entity is defined %}
  // ── 明细行 ──
  final List<{{ entity.line_entity.name }}> _lines = [];
{% endif %}

  bool get _isEditing => widget.entity != null;

  @override
  void initState() {
    super.initState();
    if (_isEditing) {
      _populateFields(widget.entity!);
    }
  }

  void _populateFields({{ entity.name }} e) {
{% for field in entity.fields %}
{% set skip = field.primary_key or field.name == "tenant_id" or field.name == "created_at" or field.name == "updated_at" or field.name == "created_by" or field.name == "updated_by" or field.name == "version" %}
{% if not skip %}
{% if field.type == "bool" %}
    _{{ field.name }} = e.{{ field.name }};
{% elif field.nullable %}
    _{{ field.name }}Controller.text = e.{{ field.name }}?.toString() ?? '';
{% else %}
    _{{ field.name }}Controller.text = e.{{ field.name }}.toString();
{% endif %}
{% endif %}
{% endfor %}
  }

  @override
  void dispose() {
{% for field in entity.fields %}
{% set skip = field.primary_key or field.name == "tenant_id" or field.name == "created_at" or field.name == "updated_at" or field.name == "created_by" or field.name == "updated_by" or field.name == "version" or field.type == "bool" %}
{% if not skip %}
    _{{ field.name }}Controller.dispose();
{% endif %}
{% endfor %}
    super.dispose();
  }

  Future<void> _submit() async {
    if (!_formKey.currentState!.validate()) return;
    setState(() => _isLoading = true);

    try {
      // TODO: 根据 _isEditing 调用 create/update provider
      if (!_isEditing) {
        // await ref.read(create{{ entity.name }}Provider(...).future);
      } else {
        // await ref.read(update{{ entity.name }}Provider(...).future);
      }
      if (mounted) {
        Navigator.of(context).pop(true);
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text(_isEditing ? '更新成功' : '创建成功')),
        );
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('操作失败: $e'), backgroundColor: Colors.red),
        );
      }
    } finally {
      if (mounted) setState(() => _isLoading = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text(_isEditing ? '编辑{{ entity.name }}' : '新建{{ entity.name }}'),
        actions: [
          TextButton.icon(
            onPressed: _isLoading ? null : _submit,
            icon: const Icon(Icons.save),
            label: const Text('保存'),
          ),
        ],
      ),
      body: Form(
        key: _formKey,
        child: ListView(
          padding: const EdgeInsets.all(16),
          children: [
            // ── Header 字段 ──
            _buildHeaderFields(),

{% if entity.line_entity is defined %}
            const Divider(height: 32),

            // ── 明细行编辑器 ──
            _buildLineEditor(),
{% endif %}
          ],
        ),
      ),
    );
  }

  Widget _buildHeaderFields() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
{% for field in entity.fields %}
{% set skip = field.primary_key or field.name == "tenant_id" or field.name == "created_at" or field.name == "updated_at" or field.name == "created_by" or field.name == "updated_by" or field.name == "version" %}
{% if not skip %}
{% if field.type == "bool" %}
        SwitchListTile(
          title: Text('{{ field.description | default(value=field.name) }}'),
          value: _{{ field.name }},
          onChanged: (v) => setState(() => _{{ field.name }} = v),
        ),
{% else %}
        TextFormField(
          controller: _{{ field.name }}Controller,
          decoration: const InputDecoration(
            labelText: '{{ field.description | default(value=field.name) }}',
            border: OutlineInputBorder(),
          ),
{% if field.type == "Decimal" or field.type == "f64" or field.type == "i32" or field.type == "i64" %}
          keyboardType: TextInputType.number,
{% elif field.type == "Email" or field.type == "String" and field.name == "email" %}
          keyboardType: TextInputType.emailAddress,
{% endif %}
{% if not field.nullable and field.default is undefined %}
          validator: (v) => (v == null || v.isEmpty) ? '{{ field.description | default(value=field.name) }}不能为空' : null,
{% endif %}
        ),
        const SizedBox(height: 12),
{% endif %}
{% endif %}
{% endfor %}
      ],
    );
  }

{% if entity.line_entity is defined %}
  Widget _buildLineEditor() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            Text(
              '{{ entity.line_entity.name | default(value="明细行") }}',
              style: Theme.of(context).textTheme.titleMedium,
            ),
            IconButton(
              icon: const Icon(Icons.add_circle_outline),
              onPressed: _addLine,
            ),
          ],
        ),
        if (_lines.isEmpty)
          const Padding(
            padding: EdgeInsets.symmetric(vertical: 16),
            child: Center(child: Text('暂无明细行，点击 + 添加')),
          )
        else
          ..._lines.asMap().entries.map((entry) {
            final index = entry.key;
            final line = entry.value;
            return _buildLineRow(index, line);
          }),
      ],
    );
  }

  Widget _buildLineRow(int index, {{ entity.line_entity.name }} line) {
    return Card(
      margin: const EdgeInsets.symmetric(vertical: 4),
      child: Padding(
        padding: const EdgeInsets.all(12),
        child: Row(
          children: [
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text('行 ${index + 1}', style: const TextStyle(fontWeight: FontWeight.bold)),
{% for field in entity.line_entity.fields | default(value=[]) %}
{% if not field.primary_key and field.name != entity.line_entity.header_fk and field.name != "created_at" and field.name != "updated_at" %}
                  Text('{{ field.description | default(value=field.name) }}: ${line.{{ field.name }}}'),
{% endif %}
{% endfor %}
                ],
              ),
            ),
            IconButton(
              icon: const Icon(Icons.delete_outline, color: Colors.red),
              onPressed: () => _removeLine(index),
            ),
          ],
        ),
      ),
    );
  }

  void _addLine() {
    // TODO: 弹出明细行编辑对话框
    setState(() {
      // _lines.add({{ entity.line_entity.name }}(...));
    });
  }

  void _removeLine(int index) {
    setState(() => _lines.removeAt(index));
  }
{% endif %}
}
