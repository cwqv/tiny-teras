{% endif %}
  @override
  Future<Result<{{ entity.name }}, Failure>> upsert({{ entity.name }} {{ entity.name | snake_case }}) async {
    try {
      final request = contracts.Create{{ entity.name }}Request()
        ..tenantId = {{ entity.name | snake_case }}.tenantId ?? ''
{% for field in entity.fields %}
{% if not field.primary_key and field.name != "tenant_id" and field.name != "created_at" and field.name != "updated_at" and field.name != "created_by" and field.name != "updated_by" and field.name != "version" and field.name != "is_deleted" and field.name != "deleted_at" and field.name != "deleted_by" %}
        ..{{ field.name }} = {{ entity.name | snake_case }}.{{ field.name }}{% if field.type == "Email" %}{% elif field.type == "Vec<String>" or field.type == "List<String>" %}.toList(){% else %}{% endif %}
{% endif %}
{% endfor %}
      ;

      final response = await _grpcClient.unaryCall<
          contracts.Create{{ entity.name }}Request,
          contracts.Created{{ entity.name }}Response>(
        contracts.{{ entity.name }}ServiceClient(_grpcClient.channel).create{{ entity.name }},
        request,
      );

      return Success(_mapProtoToEntity(response.{{ entity.name | snake_case }}));
    } catch (e, stackTrace) {
      return FailureResult(
        GrpcErrorMapper.mapToFailure(e, stackTrace),
      );
    }
  }

  @override
  Future<Result<List<{{ entity.name }}>, Failure>> listAll() async {
    try {
      final request = contracts.List{{ entity.name }}sRequest();

      final response = await _grpcClient.unaryCall<
          contracts.List{{ entity.name }}sRequest,
          contracts.List{{ entity.name }}sResponse>(
        contracts.{{ entity.name }}ServiceClient(_grpcClient.channel).list{{ entity.name }}s,
        request,
      );

      final entities = response.{{ entity.name | snake_case }}s
          .map((proto) => _mapProtoToEntity(proto))
          .toList();

      return Success(entities);
    } catch (e, stackTrace) {
      return FailureResult(
        GrpcErrorMapper.mapToFailure(e, stackTrace),
      );
    }
  }

{% if features.multi_tenant %}
  @override
  Future<Result<List<{{ entity.name }}>, Failure>> listByTenant({
    required String tenantId,
  }) async {
    try {
      final request = contracts.List{{ entity.name }}sRequest()
        ..tenantId = tenantId;

      final response = await _grpcClient.unaryCall<
          contracts.List{{ entity.name }}sRequest,
          contracts.List{{ entity.name }}sResponse>(
        contracts.{{ entity.name }}ServiceClient(_grpcClient.channel).list{{ entity.name }}s,
        request,
      );

      final entities = response.{{ entity.name | snake_case }}s
          .map((proto) => _mapProtoToEntity(proto))
          .toList();

      return Success(entities);
    } catch (e, stackTrace) {
      return FailureResult(
        GrpcErrorMapper.mapToFailure(e, stackTrace),
