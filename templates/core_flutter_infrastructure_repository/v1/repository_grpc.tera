import 'package:shared_application/shared_application.dart';
import 'package:shared_infrastructure/shared_infrastructure.dart';
import 'package:contracts_dart/contracts_dart.dart' as contracts;

import '../../domain/entities/{{ entity.name | snake_case }}.dart';
import '../../domain/repositories/{{ entity.name | snake_case }}_repository.dart';

/// gRPC {{ entity.name }}仓储实现
class Grpc{{ entity.name }}Repository implements {{ entity.name }}Repository {
  final EnhancedGrpcClient _grpcClient;

  Grpc{{ entity.name }}Repository(this._grpcClient);

{% if features.multi_tenant %}
  @override
  Future<Result<{{ entity.name }}?, Failure>> findByIdentifier({
    required String tenantId,
    required String identifier,
  }) async {
    try {
      final request = contracts.Find{{ entity.name }}ByIdentifierRequest()
        ..tenantId = tenantId
        ..identifier = identifier;

      final response = await _grpcClient.unaryCall<
          contracts.Find{{ entity.name }}ByIdentifierRequest,
          contracts.Find{{ entity.name }}ByIdentifierResponse>(
        contracts.{{ entity.name }}ServiceClient(_grpcClient.channel).findByIdentifier,
        request,
      );

      if (response.has{{ entity.name }}()) {
        return Success(_mapProtoToEntity(response.{{ entity.name | snake_case }}));
      }
      return const Success(null);
    } catch (e, stackTrace) {
      return FailureResult(
        GrpcErrorMapper.mapToFailure(e, stackTrace),
      );
    }
  }

{% endif %}
  @override
  Future<Result<{{ entity.name }}?, Failure>> findById({
    required String {% for field in entity.fields %}{% if field.primary_key %}{{ field.name }}{% endif %}{% endfor %},
{% if features.multi_tenant %}
    required String tenantId,
{% endif %}
  }) async {
    try {
      final request = contracts.Get{{ entity.name }}Request()
        ..{% for field in entity.fields %}{% if field.primary_key %}{{ field.name }}{% endif %}{% endfor %} = {% for field in entity.fields %}{% if field.primary_key %}{{ field.name }}{% endif %}{% endfor %}
{% if features.multi_tenant %}
        ..tenantId = tenantId
{% endif %}
      ;

      final response = await _grpcClient.unaryCall<
          contracts.Get{{ entity.name }}Request,
          contracts.Get{{ entity.name }}Response>(
        contracts.{{ entity.name }}ServiceClient(_grpcClient.channel).get{{ entity.name }},
        request,
      );

      if (response.has{{ entity.name }}()) {
        return Success(_mapProtoToEntity(response.{{ entity.name | snake_case }}));
      }
      return const Success(null);
    } catch (e, stackTrace) {
      return FailureResult(
        GrpcErrorMapper.mapToFailure(e, stackTrace),
      );
    }
  }

{% if features.multi_tenant %}
  @override
  Future<Result<void, Failure>> touchLastLogin({
    required String tenantId,
    required String {% for field in entity.fields %}{% if field.primary_key %}{{ field.name }}{% endif %}{% endfor %},
  }) async {
    try {
      final request = contracts.TouchLastLoginRequest()
        ..tenantId = tenantId
        ..{% for field in entity.fields %}{% if field.primary_key %}{{ field.name }}{% endif %}{% endfor %} = {% for field in entity.fields %}{% if field.primary_key %}{{ field.name }}{% endif %}{% endfor %}
      ;

      await _grpcClient.unaryCall<
          contracts.TouchLastLoginRequest,
          contracts.TouchLastLoginResponse>(
        contracts.{{ entity.name }}ServiceClient(_grpcClient.channel).touchLastLogin,
        request,
      );

      return const Success(null);
    } catch (e, stackTrace) {
      return FailureResult(
        GrpcErrorMapper.mapToFailure(e, stackTrace),
      );
    }
